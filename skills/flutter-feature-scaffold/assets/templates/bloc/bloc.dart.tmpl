/// Turns {{title_lc}} events into states. Receives its data only through
/// events and the constructor-injected dependency; it never knows other blocs.
class {{Logic}} extends Bloc<{{Event}}, {{State}}> {
{{#privnamed}}  {{Logic}}({required this._{{dep}}}) : super(const {{Feature}}Initial()){{/privnamed}}{{^privnamed}}  {{Logic}}({required {{Dep}} {{dep}}})
      : _{{dep}} = {{dep}},
        super(const {{Feature}}Initial()){{/privnamed}} {
    on<{{Feature}}Started>(_onStarted);
    on<{{Feature}}RefreshRequested>(_onRefreshRequested);
  }

  final {{Dep}} _{{dep}};

  Future<void> _onStarted(
    {{Feature}}Started event,
    Emitter<{{State}}> emit,
  ) =>
