  final {{Source}} _source;
  const {{RepositoryImpl}}(this._source);

  @override
  Future<List<{{Entity}}>> fetch{{Feature}}List() async {
    // TODO: map transport exceptions to typed failures; never log request or response bodies.
    try {
      final responses = await _source.get{{Feature}}List();
      return [for (final response in responses) response.toEntity()];
    } on DioException catch (error, stackTrace) {
      Error.throwWithStackTrace(failureFromDio(error), stackTrace);
    } on FormatException catch (_, stackTrace) {
