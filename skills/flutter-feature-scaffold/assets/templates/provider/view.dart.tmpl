import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

import '{{import:failure}}';
import '{{import:notifier}}';
import '{{import:state}}';
import '{{import:list}}';

/// Expects a [{{Logic}}] above it in the tree.
class {{View}} extends StatelessWidget {
  const {{View}}({super.key});

  @override
  Widget build(BuildContext context) {
    final state = context.watch<{{Logic}}>().state;

    return Scaffold(
      appBar: AppBar(title: const Text('{{title}}')),
      body: switch (state) {
        {{Feature}}Initial() ||
        {{Feature}}Loading() => const Center(child: CircularProgressIndicator()),
        {{Feature}}Error(:final failure) => Center(
            child: TextButton.icon(
              onPressed: context.read<{{Logic}}>().load,
              icon: const Icon(Icons.refresh),
              label: Text(_failureMessage(failure)),
            ),
          ),
        {{Feature}}Success(:final items) => {{ListWidget}}(items: items),
      },
    );
  }
}

// TODO: map the failure to a localized, user-safe message.
String _failureMessage(Failure failure) => switch (failure) {
      NetworkFailure() => 'No connection. Tap to retry.',
      _ => 'Could not load {{title_lc}}. Tap to retry.',
    };
