import 'package:flutter/foundation.dart';

import '{{import:result}}';

typedef CommandAction0<T> = Future<Result<T>> Function();
typedef CommandAction1<T, A> = Future<Result<T>> Function(A);

/// Wraps a view-model action and exposes [running], [error] and [completed],
/// so views render loading and error UI without their own flags.
///
/// Mirrors the `Command` pattern of the Flutter architecture guide
/// (docs.flutter.dev/app-architecture/design-patterns/command).
abstract class Command<T> extends ChangeNotifier {
  bool _running = false;

  /// Whether the action is running. A running command ignores new executions.
  bool get running => _running;

  Result<T>? _result;

  /// The last result, or `null` before the first run and after [clearResult].
  Result<T>? get result => _result;

  /// Whether the last run failed.
  bool get error => _result is Error<T>;

  /// Whether the last run succeeded.
  bool get completed => _result is Ok<T>;

  /// Forgets the last result, e.g. after showing its error once.
  void clearResult() {
    _result = null;
    notifyListeners();
  }

  Future<void> _execute(CommandAction0<T> action) async {
    if (_running) return;
    _running = true;
    _result = null;
    notifyListeners();
    try {
      _result = await action();
    } finally {
      _running = false;
      notifyListeners();
    }
  }
}

/// A [Command] without arguments.
final class Command0<T> extends Command<T> {
  Command0(this._action);

  final CommandAction0<T> _action;

  Future<void> execute() => _execute(_action);
}

/// A [Command] with one argument.
final class Command1<T, A> extends Command<T> {
  Command1(this._action);

  final CommandAction1<T, A> _action;

  Future<void> execute(A argument) => _execute(() => _action(argument));
}
