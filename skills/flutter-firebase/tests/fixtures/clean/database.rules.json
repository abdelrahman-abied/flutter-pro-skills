{
  // comments are allowed in Realtime Database rules
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      ".read": true
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
